  "private": true,
  "type": "module",
  "scripts": {
    "sync-readme": "node scripts/sync-readme.mjs",
    "build-terms-index": "node scripts/build-terms-index.mjs",
    "predev": "npm run sync-readme && npm run build-terms-index",
    "dev": "astro dev",
