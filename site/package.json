{
  "name": "boat-tech-directory-site",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-readme": "node scripts/sync-readme.mjs",
    "build-terms-index": "node scripts/build-terms-index.mjs",
    "build-spreadsheets": "node scripts/build-spreadsheets.mjs",
    "sync-spreadsheets": "uv run scripts/sync_spreadsheets.py",
    "predev": "npm run sync-readme && npm run build-spreadsheets && npm run build-terms-index",
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "npm run sync-readme && npm run build-spreadsheets && npm run build-terms-index",
    "build": "astro build",
    "build:signalk": "ASTRO_BASE=/@rhizomatics/signalk-boat-tech-directory-plugin ASTRO_OUTDIR=dist-signalk npm run build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.42.4",
    "astro": "^7.3.5",
    "exceljs": "^4.4.0",
    "github-slugger": "2.0.0",
    "hast-util-to-string": "3.0.1",
    "mdast-util-to-string": "4.0.0",
    "pdfmake": "^0.3.11",
    "remark-parse": "11.0.0",
    "starlight-agentready": "^1.0.0",
    "starlight-llms-txt": "^0.12.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
