---
// Overrides Starlight's default Head to advertise the raw-Markdown twin of the current
// page (served by src/pages/[...slug].md.ts) via a <link rel="alternate">, so agents that
// follow standard discovery hints can fetch Markdown instead of scraping rendered HTML.
//
// Also emits schema.org JSON-LD for search engines: WebSite on the home page, and a
// BreadcrumbList elsewhere, plus an ItemList of the page's entries on directory pages, and
// of the plugins (as SoftwareApplication) on the generated SignalK Plugins pages.
// URLs are absolute against `site`, the public canonical domain (see directory.json.ts).
//
// And loads GoatCounter analytics on the public production site (see ../analytics.mjs).
import { existsSync, readFileSync } from "node:fs";
import { resolve } from "node:path";
import Default from "@astrojs/starlight/components/Head.astro";
import { extractEntries, isDirectoryPage } from "../directory-entries.mjs";
import { sections } from "../../sections.mjs";
import { goatcounterUrl } from "../analytics.mjs";

const { id, entry } = Astro.locals.starlightRoute;
const mdSlug = id === "" ? "index" : id;
// BASE_URL is normalized with a leading slash but not always a trailing one
// (e.g. the signalk-webapp build's "/@rhizomatics/signalk-boat-tech-directory-plugin").
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const abs = (path: string) => new URL(path, Astro.site).href;
const siteName = "Boat Tech Directory";
const pageUrl = abs(id === "" ? "/" : `/${id}/`);

// Parent of a page, for breadcrumbs: the section it's listed under in sections.mjs, or for a
// nested page not in the sidebar (signalk-plugins/ais), the page its path sits under.
type Section = { label: string; slug: string; children?: Section[] };
const labels = new Map<string, string>();
const parents = new Map<string, string>();
const addSections = (list: Section[], parent?: string) => {
  for (const section of list) {
    labels.set(section.slug, section.label);
    if (parent) parents.set(section.slug, parent);
    addSections(section.children ?? [], section.slug);
  }
};
addSections(sections);
function parentOf(slug: string): string | undefined {
  if (parents.has(slug)) return parents.get(slug);
  const prefix = slug.includes("/") ? slug.slice(0, slug.lastIndexOf("/")) : undefined;
  return prefix && labels.has(prefix) ? prefix : undefined;
}
function ancestors(slug: string): string[] {
  const parent = parentOf(slug);
  return parent ? [...ancestors(parent), parent] : [];
}

// Written by scripts/build-signalk-plugins.mjs; absent if its fetch failed.
const SIGNALK_PREFIX = "signalk-plugins";
const isSignalkPage = id === SIGNALK_PREFIX || id.startsWith(`${SIGNALK_PREFIX}/`);
const signalkDataPath = resolve(process.cwd(), "public/signalk-plugins.json");
const signalkData =
  isSignalkPage && existsSync(signalkDataPath) ? JSON.parse(readFileSync(signalkDataPath, "utf8")) : null;

const graph: object[] = [];
if (id === "" || id === "index") {
  graph.push({
    "@type": "WebSite",
    name: siteName,
    url: abs("/"),
    description: entry.data.description,
    inLanguage: "en",
    license: "https://creativecommons.org/licenses/by-sa/4.0/",
  });
} else if (id !== "404") {
  const crumbs = [
    { name: siteName, url: abs("/") },
    ...ancestors(id).map((slug) => ({ name: labels.get(slug), url: abs(`/${slug}/`) })),
    { name: entry.data.title, url: pageUrl },
  ];
  graph.push({
    "@type": "BreadcrumbList",
    itemListElement: crumbs.map((crumb, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: crumb.name,
      item: crumb.url,
    })),
  });

  const collectionPage = (mainEntity: object) => ({
    "@type": "CollectionPage",
    name: entry.data.title,
    description: entry.data.description,
    url: pageUrl,
    isPartOf: { "@type": "WebSite", name: siteName, url: abs("/") },
    ...(signalkData ? { dateModified: signalkData.generated } : {}),
    mainEntity,
  });

  if (signalkData && id === SIGNALK_PREFIX) {
    graph.push(
      collectionPage({
        "@type": "ItemList",
        numberOfItems: signalkData.categories.length,
        itemListElement: signalkData.categories.map((c: { name: string; url: string }, i: number) => ({
          "@type": "ListItem",
          position: i + 1,
          name: c.name,
          url: c.url,
        })),
      }),
    );
  } else if (signalkData && isSignalkPage) {
    // Each entry links first to its npm page; join on that URL for the structured fields,
    // and to the page for the entry's anchor. (Names alone can repeat across npm scopes.)
    const plugins = new Map(signalkData.plugins.map((p: { npmUrl: string }) => [p.npmUrl, p]));
    const entries = extractEntries(entry.body ?? "").filter((e) => e.href && plugins.has(e.href));
    graph.push(
      collectionPage({
        "@type": "ItemList",
        numberOfItems: entries.length,
        itemListElement: entries.map((e, i) => {
          const p = plugins.get(e.href);
          return {
            "@type": "ListItem",
            position: i + 1,
            url: `${pageUrl}#${e.anchorId}`,
            item: {
              "@type": "SoftwareApplication",
              name: p.name,
              url: p.npmUrl,
              ...(p.description ? { description: p.description } : {}),
              softwareVersion: p.version,
              ...(p.published ? { dateModified: p.published } : {}),
              applicationCategory: "SignalK server plugin",
              applicationSubCategory: p.categories.join(", "),
              operatingSystem: "SignalK server",
              ...(p.sourceUrl ? { sameAs: p.sourceUrl } : {}),
            },
          };
        }),
      }),
    );
  } else if (isDirectoryPage(id)) {
    const entries = extractEntries(entry.body ?? "");
    graph.push(
      collectionPage({
        "@type": "ItemList",
        numberOfItems: entries.length,
        itemListElement: entries.map((e, i) => ({
          "@type": "ListItem",
          position: i + 1,
          url: `${pageUrl}#${e.anchorId}`,
          item: {
            "@type": "Thing",
            name: e.name,
            ...(e.href ? { url: new URL(e.href, pageUrl).href } : {}),
            ...(e.description ? { description: e.description } : {}),
          },
        })),
      }),
    );
  }
}

// Escape "<" so entry text can never close the <script> element early.
const jsonLd = graph.length
  ? JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(/</g, "\\u003c")
  : null;
---

{goatcounterUrl && <script is:inline async data-goatcounter={goatcounterUrl} src="https://gc.zgo.at/count.js" />}
<Default />
{/* iOS/iPadOS ignore SVG favicons; without this, "Add to Home Screen" uses a page screenshot. */}
<link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
{/* Home-screen label; otherwise iOS uses the page <title> (e.g. "Plotters | Boat Tech Directory"), truncated. */}
<meta name="apple-mobile-web-app-title" content="Boat Tech" />
<link rel="alternate" type="text/markdown" href={`${base}${mdSlug}.md`} />
{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
