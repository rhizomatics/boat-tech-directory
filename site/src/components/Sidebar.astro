---
// Overrides Starlight's default Sidebar with a tree built from sections.mjs, folding page
// outlines (headings) into the nav instead of a separate "On this page" panel in the right
// column (disabled via `tableOfContents: false` in astro.config.mjs).
//
// - Every section is listed, with its child pages indented under it.
// - The current page shows its outline: its headings, two levels deep.
// - A child page can be attached to a heading of its parent with `heading: "<slug>"` in
//   sections.mjs (SignalK Plugins sits under Open Source Projects' "SignalK" heading). The
//   parent's outline then stays open while on the parent or anywhere below that child, with
//   the child, and its own children, nested under that heading.
// - Children of child pages are only listed while their branch is open.
//
// Starlight's own `sidebar` config (astro.config.mjs) is still used for prev/next links.
import { getEntry, render } from "astro:content";
import SidebarPersister from "@astrojs/starlight/components/SidebarPersister.astro";
import MobileMenuFooter from "virtual:starlight/components/MobileMenuFooter";
import { sections } from "../../sections.mjs";
import SidebarTree, { type Node } from "./SidebarTree.astro";

type Section = { label: string; slug: string; heading?: string; children?: Section[] };
type Heading = { depth: number; slug: string; text: string };

const { id, headings: currentHeadings = [] } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const pageHref = (slug: string) => `${base}${slug}/`;

const contains = (section: Section): boolean =>
  section.slug === id || (section.children ?? []).some(contains);

// Wide enough to catch every heading depth actually used across content pages (some use
// h2/h3 for sections, others h3/h4), shallow enough not to bloat the nav for the busiest
// pages. Content pages only use one or two heading depths, so nest the second depth found
// under the nearest preceding heading of the first (shallowest) depth.
function headingTree(headings: Heading[]) {
  const pageHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 4);
  const topDepth = Math.min(...pageHeadings.map((h) => h.depth));
  const tree: { heading: Heading; children: Heading[] }[] = [];
  for (const heading of pageHeadings) {
    if (heading.depth === topDepth) tree.push({ heading, children: [] });
    else tree.at(-1)?.children.push(heading);
  }
  return tree;
}

async function headingsOf(slug: string): Promise<Heading[]> {
  if (slug === id) return currentHeadings;
  const entry = await getEntry("docs", slug);
  return entry ? (await render(entry)).headings : [];
}

async function pageNode(section: Section, depth: number, branchOpen: boolean): Promise<Node> {
  const current = section.slug === id;
  const open = branchOpen || contains(section);
  const children = section.children ?? [];
  const attached = children.filter((child) => child.heading);
  const placed = new Set<Section>();
  const node: Node = { label: section.label, href: pageHref(section.slug), kind: "page", current, children: [] };

  if (current || attached.some(contains)) {
    const href = (slug: string) => (current ? `#${slug}` : `${pageHref(section.slug)}#${slug}`);
    const under = async (headingSlug: string) => {
      const nodes: Node[] = [];
      for (const child of attached.filter((c) => c.heading === headingSlug)) {
        placed.add(child);
        nodes.push(await pageNode(child, depth + 1, true));
      }
      return nodes;
    };
    const headingNode = async (heading: Heading, subs: Node[] = []): Promise<Node> => ({
      label: heading.text,
      href: href(heading.slug),
      kind: "heading",
      children: [...(await under(heading.slug)), ...subs],
    });
    for (const { heading, children: subs } of headingTree(await headingsOf(section.slug))) {
      const subNodes = [];
      for (const sub of subs) subNodes.push(await headingNode(sub));
      node.children.push(await headingNode(heading, subNodes));
    }
  }

  // Child pages not placed under a heading (e.g. the outline isn't showing).
  if (depth === 0 || open) {
    for (const child of children) {
      if (!placed.has(child)) node.children.push(await pageNode(child, depth + 1, false));
    }
  }
  return node;
}

const nodes: Node[] = [
  { label: "Home", href: base, kind: "page", current: id === "" || id === "index", children: [] },
];
for (const section of sections) nodes.push(await pageNode(section, 0, false));
---

<SidebarPersister>
  <SidebarTree nodes={nodes} />
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>
