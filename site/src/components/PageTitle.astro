---
// Overrides Starlight's PageTitle to add a hero promoting the SignalK plugin under the
// home page title. The home page body is regenerated from README.md (scripts/sync-readme.mjs),
// so the hero lives here rather than in the content.
//
// Only on the public site: the SignalK plugin build (non-root BASE_URL) *is* the plugin,
// so advertising it there would be pointless.
import Default from "@astrojs/starlight/components/PageTitle.astro";
import SignalkHero from "./SignalkHero.astro";

const { id } = Astro.locals.starlightRoute;
const showHero = (id === "" || id === "index") && import.meta.env.BASE_URL === "/";
---

<Default />
{showHero && <SignalkHero />}
